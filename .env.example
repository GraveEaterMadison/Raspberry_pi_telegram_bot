# Usage:
#   cp .env.example .env
#   nano .env   ← fill in your values
#   python main.py

# ── Required ──────────────────────────────────────────────────────────────────
# Get this from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram user ID (integer). Find it via @userinfobot.
# Comma-separated for multiple users: 123456789,987654321
AUTHORIZED_USERS=123456789

# ── Optional: AI backend ──────────────────────────────────────────────────────
AI_PROVIDER=anthropic          # or: openai
ANTHROPIC_API_KEY=             # get at console.anthropic.com
OPENAI_API_KEY=                # get at platform.openai.com

# Cheapest current Claude model. Used for /ai and for the smart chat router
# that lets the AI pick and run one of the bot's commands on its own.
AI_MODEL=claude-haiku-4-5-20251001
# Caps Claude's reply length (tokens) — keeps every call cheap.
AI_MAX_TOKENS=400
# If true, every plain chat message (no leading /) is sent to the AI, which
# then either replies normally or runs one of the commands below itself.
# Set to false to only use the AI via the explicit /ai command.
AI_SMART_CHAT=true
# Comma-separated command names to hide from the AI entirely (they stay
# available as normal /commands). Example: AI_EXCLUDED_COMMANDS=exec,kill
AI_EXCLUDED_COMMANDS=

# ── Optional: /integrate <github-url> ──────────────────────────────────────────
# Turns a GitHub repo into a new AI skill (clone -> AI writes a skills/
# wrapper -> you confirm in Telegram -> it's activated). See README.
VENDOR_DIR=data/vendor
AI_INTEGRATION_MAX_TOKENS=2000
INTEGRATION_CLONE_TIMEOUT=90
INTEGRATION_INSTALL_TIMEOUT=180

# ── Optional: Weather ─────────────────────────────────────────────────────────
# Free key at openweathermap.org (current weather API)
OPENWEATHER_API_KEY=

# ── Optional: Hardware ────────────────────────────────────────────────────────
CAMERA_BACKEND=picamera2       # picamera2 | opencv | dummy
GPIO_MODE=BCM                  # BCM | BOARD
DHT_SENSOR_TYPE=DHT22          # DHT11 | DHT22
DHT_PIN=4
BMP280_ADDRESS=0x76
PIR_PIN=17

# ── Optional: Tuning ──────────────────────────────────────────────────────────
BACKUP_PATHS=/home/pi,/etc
MAX_EXEC_OUTPUT=4000
RATE_LIMIT_PER_MINUTE=20
METRICS_HISTORY_SIZE=60
METRICS_INTERVAL=10
LOG_LEVEL=INFO
DB_PATH=data/bot.db

# Leave blank to allow all exec commands for authorized users:
EXEC_WHITELIST=
# Always blocked regardless of authorization:
EXEC_BLACKLIST=rm -rf /,mkfs,dd if=/dev/zero

# ── New integrations (optional) ───────────────────────────────────────────────

# Bluetooth watches — comma-separated MAC addresses
# WATCH_ADDRESSES=AA:BB:CC:DD:EE:FF,11:22:33:44:55:66

# Path to the watch_notifier Unix socket (default: /tmp/watch_notifier.sock)
# WATCH_NOTIFIER_SOCKET=/tmp/watch_notifier.sock

# GigaChat (Sberbank) API credentials (base64-encoded)
# GIGACHAT_CREDENTIALS=<your-base64-credential>

# Yandex Cloud service account key JSON path
# YANDEX_SERVICE_ACCOUNT_KEY_PATH=/home/pi/.config/yandex/sa-key.json
# YANDEX_FOLDER_ID=<your-folder-id>
